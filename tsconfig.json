{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@shared/*": [
        "shared/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/e-commerce-monorepo/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/e-commerce-microservices/tsconfig.app.json"
    },
    {
      "path": "./apps/users/tsconfig.app.json"
    },
    {
      "path": "./apps/notifications-service/tsconfig.app.json"
    }
  ]
}